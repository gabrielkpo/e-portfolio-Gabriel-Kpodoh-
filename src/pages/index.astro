---
import H1 from "../components/h1.astro";
import Link from "../components/link.astro";
import Navigation from "../components/navigation";
import RootLayout from "../layouts/RootLayout.astro";
import WarpBackground from "../components/warp-background";
import AvailableForWork from "../components/available.astro";
---

<RootLayout>
	<main>
		<div class="group relative w-full min-h-dvh flex items-center justify-center">
			<div class="absolute w-full h-dvh -z-10">
				<WarpBackground
					color1="#09090b"
					color2="#27272a"
					color3="#52525b"
					speed={0.6}
					swirl={0.5}
					swirlIterations={10}
					shapeScale={0.3}
					client:load
				/>
			</div>

			<div class="p-4 sm:p-8 absolute w-full h-dvh flex flex-col justify-between z-10">
				<div>
					<H1 size="large"> Gabriel <br /> Kpodoh </H1>
				</div>

				<div>
					<AvailableForWork className="py-4" />
						<div class="mb-2 sm:mb-4 flex items-center justify-between">
							<div class="flex items-center gap-4">
								<Link href="/projects" variant="secondary">En savoir plus</Link>
								<!-- CV button: points to /CV.pdf in the public folder. Add CV.pdf to public/ to enable download/open. -->
								<Link href="/CV.pdf" variant="primary" className="hidden sm:inline-block" >CV</Link>
							</div>

						<Navigation client:load>
							<Link href="/blog" variant="secondary">Blog</Link>
							<Link href="/parcours" variant="secondary">Parcours</Link>
							<Link href="/competences" variant="secondary">Compétences</Link>
							<Link href="/international-mobility" variant="secondary">International Mobility</Link>
							<Link href="/sustainability-engagement" variant="secondary">Sustainability & Civic Engagement</Link>
							<Link href="/career-development" variant="secondary">Career Development</Link>
							<Link href="/contact" variant="secondary">Contact</Link>
						</Navigation>
					</div>
				</div>
			</div>
		</div>
	</main>
</RootLayout>

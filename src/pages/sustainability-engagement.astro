---
import H1 from "../components/h1.astro";
import InfoLayout from "../layouts/InfoLayout.astro";
---

<InfoLayout title="Sustainability & Civic Engagement — Gabriel">
  <div class="p-4 sm:pt-8 sm:px-12 pb-20 min-h-dvh flex flex-col gap-12 max-w-6xl mx-auto">
    <H1>Sustainability & Civic Engagement</H1>
    
    <p class="text-xl xl:text-2xl text-zinc-500 text-balance">
      Mon engagement pour un avenir durable et mes contributions à la vie civique et associative.
    </p>

    <div class="space-y-12">
      <div class="bg-zinc-800/60 border border-zinc-700 rounded-xl p-8 border-l-4 border-l-green-500">
        <h2 class="text-white text-2xl font-semibold mb-4">Développement Durable</h2>
        <p class="text-zinc-400 leading-relaxed">
          Projets et initiatives visant à réduire l'empreinte carbone et à promouvoir des pratiques éco-responsables dans le numérique.
        </p>
      </div>

      <div class="bg-zinc-800/60 border border-zinc-700 rounded-xl p-8 border-l-4 border-l-blue-500">
        <h2 class="text-white text-2xl font-semibold mb-4">Engagement Citoyen</h2>
        <p class="text-zinc-400 leading-relaxed">
          Bénévolat, mentorat et participation à des projets communautaires.
        </p>
      </div>
    </div>
  </div>
</InfoLayout>

---
import { Image } from 'astro:assets';
import H1 from "../components/h1.astro";
import InfoLayout from "../layouts/InfoLayout.astro";
import ronaldo from "../assets/ronaldo.jpg";
import orange from "../assets/orange.png";
import pompier from "../assets/pompier.jpg";
import Bac from "../assets/bac.avif";
import Aero from "../assets/Aero.jpg";
import inge from "../assets/inge.jpg";
import N7 from "../assets/N7.jpg";
import logo from "../assets/logo.png";
import market from "../assets/market.avif";

const steps = [
     {
          title: "BIA (Brevet d'Initiation Aéronautique)",
          period: "2018",
          description: "Formation BIA : connaissances en aéronautique, sécurité et procédures de base.",
          image: Aero
     },
     {
          title: "Stage d'observation cybersécurité — Orange ",
          period: "2019",
          description: "Observation et immersion dans les équipes cybersécurité : sensibilisation aux menaces et bonnes pratiques.",
          image: orange
     },
     {
          title: "Pompier volontaire",
          period: "2018 à aujourd'hui",
          description: "Engagement civique : interventions, formation aux gestes de premiers secours et travail en équipe.",
          image: pompier
     },
     {
          title: "Baccalauréat",
          period: "2022",
          description: "Diplôme de fin d'études secondaires, fondation des connaissances générales.",
          image: Bac
     },
     {
          title: "Classe préparatoire aux grandes écoles (CPGE) — Filière PT",
          period: "2022 - 2024",
          description: "Formation intensive en mathématiques, physique et sciences de l'ingénieur.",
          image: inge
     },
     {
          title: "Diplôme Ingénieur ENSEEIHT - Artificial Intelligence & Image Treatment",
          period: "2024 - Aujourd'hui",
          description: "Formation d'ingénieur spécialisée en intelligence artificielle et traitement d'images à l'ENSEEIHT.",
          image: N7
     },
     {
          title: "Chef de projet — n7Consulting",
          period: "2024 - 2025",
          description: "Gestion de projets, coordination d'équipes et suivi des livrables chez n7Consulting.",
          image: logo
     },
     {
          title: "Responsable marketing",
          period: "2025 - Aujourd'hui",
          description: "Stratégie marketing, campagnes, communication et analyse des performances.",
          image: market
     }
];
---

<InfoLayout>
     <div class="p-4 sm:pt-8 sm:px-12 pb-20 min-h-dvh">
          <div class="space-y-4 sm:space-y-12 max-w-4xl mx-auto">
               <H1> Parcours professionnel </H1>

               <p class="text-xl xl:text-2xl text-zinc-500 text-balance">
                    Voici une timeline de mon parcours professionnel. Clique sur une étape pour plus de détails (tu peux modifier les étapes dans le code).
               </p>

               <div class="mt-8 relative">
                    <!-- vertical line -->
                    <div class="hidden sm:block absolute left-6 top-0 bottom-0 w-0.5 bg-zinc-800"></div>

                    <ol class="space-y-12">
                         {steps.map((step, i) => (
                              <li class="relative pl-14 sm:pl-20">
                                   <span class="absolute left-6 top-1/2 w-3 h-3 rounded-full bg-zinc-500 ring-4 ring-zinc-900 -translate-x-1/2 -translate-y-1/2"></span>

                                   <div class="flex flex-col sm:flex-row items-start gap-4">
                                        <div class="w-full sm:w-70 flex-shrink-0">
                                             <Image src={step.image} alt={step.title} class="w-full h-40 object-cover rounded-lg shadow-md" />
                                        </div>

                                        <div class="flex-1">
                                             <h3 class="text-zinc-100 font-medium">{step.title}</h3>
                                             <p class="text-zinc-400 text-sm">{step.period}</p>
                                             <p class="text-zinc-400 mt-2 text-balance">{step.description}</p>
                                        </div>
                                   </div>
                              </li>
                         ))}
                    </ol>
               </div>
          </div>
     </div>
</InfoLayout>

---
import { Image } from "astro:assets";
import H1 from "../components/h1.astro";
import InfoLayout from "../layouts/InfoLayout.astro";
import mondeImage from "../assets/monde.jpg";

const destinations = [
  { name: "Berlin", top: "32%", left: "51%", description: "Voyage d'étude / Échange" },
  { name: "Albanie", top: "40%", left: "53%", description: "Exploration culturelle" },
  { name: "Italie", top: "40%", left: "50%", description: "Séjour académique" },
  { name: "Madagascar", top: "72%", left: "63%", description: "Mission Humanitaire" },
  { name: "Espagne", top: "41%", left: "47%", description: "Projet linguistique" },
  { name: "Grèce", top: "41%", left: "54%", description: "Découverte historique" },
];
---

<InfoLayout title="International Mobility — Gabriel">
  <div class="p-4 sm:pt-8 sm:px-12 pb-20 min-h-dvh flex flex-col gap-12 max-w-6xl mx-auto">
    <H1>International Mobility</H1>
    
    <p class="text-xl xl:text-2xl text-zinc-500 text-balance">
      Découvrez mes expériences à l'étranger, mes échanges académiques et mes projets internationaux.
    </p>

    <!-- Carte du Monde -->
    <div class="bg-zinc-800/40 border border-zinc-700 rounded-2xl p-4 sm:p-8 overflow-hidden">
      <h2 class="text-white text-xl font-semibold mb-8">Mes destinations</h2>
      
      <div class="relative w-full aspect-[16/9] bg-zinc-900 rounded-lg overflow-hidden group">
        <Image 
          src={mondeImage} 
          alt="Carte du monde des destinations" 
          class="w-full h-full object-cover opacity-60 group-hover:opacity-80 transition-opacity duration-500"
        />
        
        {destinations.map((dest) => (
          <div 
            class="absolute group/pin" 
            style={`top: ${dest.top}; left: ${dest.left};`}
          >
            <!-- Point d'intérêt -->
            <div class="relative flex items-center justify-center">
              <div class="absolute w-3 h-3 bg-white rounded-full animate-ping opacity-75"></div>
              <div class="relative w-2 h-2 bg-white rounded-full border border-zinc-900 shadow-xl"></div>
            </div>
            
            <!-- Tooltip / Label -->
            <div class="absolute bottom-full left-1/2 -translate-x-1/2 mb-2 p-2 bg-zinc-900 border border-zinc-700 rounded-lg shadow-2xl opacity-0 group-hover/pin:opacity-100 transition-all duration-300 pointer-events-none whitespace-nowrap z-20">
              <p class="text-xs font-bold text-white">{dest.name}</p>
              <p class="text-[10px] text-zinc-400">{dest.description}</p>
            </div>
          </div>
        ))}
      </div>

      <div class="mt-8 grid grid-cols-2 sm:grid-cols-3 md:grid-cols-6 gap-4">
        {destinations.map(dest => (
          <div class="flex flex-col gap-1">
            <span class="text-white text-sm font-medium">{dest.name}</span>
            <span class="text-zinc-500 text-[10px] leading-tight">{dest.description}</span>
          </div>
        ))}
      </div>
    </div>
    
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      <div class="bg-zinc-800/60 border border-zinc-700 rounded-xl p-8">
        <h2 class="text-white text-xl font-semibold mb-4">Échanges Académiques</h2>
        <p class="text-zinc-400 leading-relaxed mb-4">
          Je projette de poursuivre mon cursus avec un master spécialisé de haut niveau à l'étranger pour approfondir mes compétences techniques.
        </p>
        <ul class="space-y-4">
          <li class="flex flex-col">
            <span class="text-zinc-100 font-medium">Environmental Data Science and Machine Learning MSc</span>
            <span class="text-zinc-500 text-sm italic">Imperial College London</span>
          </li>
          <li class="flex flex-col">
            <span class="text-zinc-100 font-medium">MSc Program</span>
            <span class="text-zinc-500 text-sm italic">Cranfield University</span>
          </li>
        </ul>
      </div>
      
      <div class="bg-zinc-800/60 border border-zinc-700 rounded-xl p-8">
        <h2 class="text-white text-xl font-semibold mb-4">Stages à l'International</h2>
        <p class="text-zinc-400 leading-relaxed">
          Actuellement en recherche d'opportunités, je suis particulièrement intéressé par des expériences professionnelles en Amérique du Nord.
        </p>
        <div class="mt-4 flex flex-wrap gap-2">
          <span class="px-3 py-1 bg-zinc-700/50 text-zinc-300 text-xs rounded-full border border-zinc-600">🇨🇦 Canada</span>
          <span class="px-3 py-1 bg-zinc-700/50 text-zinc-300 text-xs rounded-full border border-zinc-600">🇺🇸 USA</span>
        </div>
        <p class="mt-4 text-zinc-500 text-sm">
          Ouvert à toute proposition stimulante dans le domaine de l'ingénierie et de la data.
        </p>
      </div>
      
      <div class="bg-zinc-800/60 border border-zinc-700 rounded-xl p-8 md:col-span-2">
        <h2 class="text-white text-xl font-semibold mb-4">Langues</h2>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
          <div>
            <p class="text-zinc-300 font-medium text-lg text-white">Français</p>
            <p class="text-zinc-500 text-sm">Langue maternelle</p>
          </div>
          <div>
            <p class="text-zinc-300 font-medium text-lg text-white">Anglais</p>
            <p class="text-zinc-500 text-sm">Niveau B2 (Courant professionnel)</p>
          </div>
          <div>
            <p class="text-zinc-300 font-medium text-lg text-white">Espagnol</p>
            <p class="text-zinc-500 text-sm">Niveau A1 (Notions de base)</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</InfoLayout>

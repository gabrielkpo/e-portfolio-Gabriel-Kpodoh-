---
import clsx from "clsx";
import { actions } from "../../actions/index";
import H1 from "../../components/h1.astro";
import { formatDate } from "../../lib/utils";
import InfoLayout from "../../layouts/InfoLayout.astro";

const categoriesResult = await actions.categories.getCategories();
const categories = categoriesResult?.categories || [];

const selectedCategory = Astro.url.searchParams.get("category") || "all";

const articlesResult = await actions.categories.filterByCategory({
    category: selectedCategory,
});

if (!articlesResult?.success) {
    console.log("error fetching articles", articlesResult);
}

const articles = articlesResult?.articles || [];
---

<InfoLayout>
    <div class="p-4 sm:pt-8 sm:px-12 pb-20 min-h-dvh">
        <H1> Blog </H1>

        <ul class="mt-4 flex flex-wrap items-center gap-4">
            <!-- Fixed, ordered categories (French labels) -->
            {[
                { label: 'Tous', slug: 'all' },
                { label: 'IA', slug: 'ia' },
                { label: 'Systèmes embarqués', slug: 'systemes-embarques' },
                { label: 'Sport', slug: 'sport' },
                { label: 'Pompier', slug: 'pompier' },
                { label: 'Marketing', slug: 'marketing' },
            ].map((cat) => (
                <li>
                    <a
                        href={cat.slug === 'all' ? '/blog' : `/blog?category=${encodeURIComponent(cat.slug)}`}
                        class={clsx("w-fit px-4 py-1 text-sm bg-transparent rounded-full transition-all duration-300 ease-in-out",
                            selectedCategory === (cat.slug === 'all' ? 'all' : cat.slug.toLowerCase()) ? "text-white bg-zinc-100/20 outline-2 outline-offset-2 outline-zinc-100/20" : "text-zinc-400 hover:text-zinc-200"
                        )}
                    >
                        {cat.label}
                    </a>
                </li>
            ))}

            <!-- Include any additional categories detected dynamically (to avoid hiding existing ones) -->
            {categories.filter((c) => !['IA','Sport','Pompier','Marketing','Systèmes embarqués'].includes(c.label)).map((category) => (
                <li>
                    <a
                        href={`/blog?category=${encodeURIComponent(category.slug)}`}
                        class={clsx("w-fit px-4 py-1 text-sm bg-transparent rounded-full transition-all duration-300 ease-in-out",
                            selectedCategory === category.slug ? "text-white bg-zinc-100/20 outline-2 outline-offset-2 outline-zinc-100/20" : "text-zinc-400 hover:text-zinc-200"
                        )}
                    >
                        {category.label}
                    </a>
                </li>
            ))}
        </ul>

        <ul class="mt-4 space-y-6">
            {
                articles.map((article) => (
                    <li>
                        <a
                            class="space-y-1 group"
                            href={`/blog/${article.data.slug}`}
                        >
                            <h2 class="text-xl xl:text-2xl text-zinc-300 group-hover:text-white text-balance font-medium underline group-hover:underline-offset-2 decoration-transparent group-hover:decoration-zinc-500">
                                {article.data.title}
                            </h2>
                            <p class="text-base text-zinc-400">
                                {article.data.snippet}
                            </p>
                            <p class="text-sm text-zinc-500">
                                {formatDate(article.data.pubDate)} &middot;{" "}
                                {article.data.author}
                            </p>
                        </a>
                    </li>
                ))
            }
        </ul>
    </div>
</InfoLayout>
